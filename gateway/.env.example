GLPI_URL=https://suporte.usinabr.com.br/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TIMEOUT=30

# Segurança das operações GLPI
GLPI_ALLOWED_ENTITY_IDS=
GLPI_ALLOW_CREATE=true
GLPI_ALLOW_UPDATE=true
GLPI_ALLOW_FOLLOWUP=true
GLPI_ALLOW_ASSIGNMENT=true
GLPI_ALLOW_STATUS_CHANGE=true
GLPI_ALLOW_SOLUTION=true
GLPI_ALLOW_CLOSE=false
GLPI_AUDIT_FILE=logs/audit.jsonl

# Transporte MCP
# stdio = Inspector/desenvolvimento local
# streamable-http = servidor MCP HTTP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Proteção contra DNS rebinding
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# Autenticação HTTP
# A autenticação é aplicada ao endpoint MCP; /health permanece público.
MCP_AUTH_ENABLED=false
MCP_BEARER_TOKEN=
MCP_REQUIRED_SCOPES=glpi:mcp
MCP_AUTH_ISSUER=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp

# Em produção, use HTTPS e substitua a autenticação estática por OAuth/JWT.
# Nunca versione o token real.
